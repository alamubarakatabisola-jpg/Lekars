rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read & write operations for products collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Allow read & write operations for services collection
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Allow read & write operations for inquiries collection
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

  }
}
